<%# The census screens use the admin pack for the member rows, the live
    security meter and the credential limit. %>
<% append_javascript_pack_tag "decidim_secure_elections_admin" %>

<% add_decidim_page_title(t(".page_title")) %>

<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "nav", locals: { election: } %>

<%#
  The census page.

  Two things, in the order they matter: *how* a voter proves who they are, and
  *who* the voters are. An admin never sees a Vocdoni identifier here — Decidim
  holds the census and the publish job creates the members, the group and the
  census upstream.
%>

<div class="card">
  <div class="card-divider">
    <h2 class="card-title justify-between">
      <span class="text-black font-bold"><%= t(".authentication_title") %></span>
      <% if allowed_to?(:update, :census, election: election) %>
        <%= link_to edit_election_census_path(election), class: "flex items-end justify-between gap-x-3 text-sm" do %>
          <%= icon "pencil-line", class: "!w-4 !h-4" %>
          <%= election.census_configured? ? t(".edit_authentication") : t(".configure_authentication") %>
        <% end %>
      <% end %>
    </h2>
  </div>

  <div class="card-section">
    <% if election.census_configured? %>
      <%= render partial: "summary", locals: { election: } %>
    <% else %>
      <%= cell "decidim/announcement",
               { title: t(".not_configured_title"), body: t(".not_configured_body") },
               callout_class: "warning" %>
    <% end %>
  </div>
</div>

<%# Anything the upstream group validation complained about, named. %>
<% if reported_missing_members.any? %>
  <div class="mt-4">
    <%= cell "decidim/announcement",
             { title: t(".reported_missing_title", count: reported_missing_members.size),
               body: t(".reported_missing_body", names: reported_missing_members.map(&:display_name).to_sentence) },
             callout_class: "alert" %>
  </div>
<% end %>

<div class="card mt-4">
  <div class="card-divider">
    <h2 class="card-title justify-between">
      <span class="text-black font-bold">
        <%= t(".people_title") %>
        <span class="label basic"><%= t(".people_count", count: census_members.size) %></span>
      </span>

      <% if allowed_to?(:update, :census, election: election) %>
        <%= link_to election_census_members_path(election), class: "flex items-end justify-between gap-x-3 text-sm" do %>
          <%= icon "pencil-line", class: "!w-4 !h-4" %>
          <%= t(".edit_people") %>
        <% end %>
      <% end %>
    </h2>
  </div>

  <div class="card-section">
    <% if census_members.none? %>
      <p class="text-gray-2"><%= t(".people_empty") %></p>
    <% else %>
      <% if incomplete_members.any? %>
        <%= cell "decidim/announcement",
                 { title: t(".incomplete_title", count: incomplete_members.size),
                   body: t(".incomplete_body",
                           details: election.census_members_missing_by_field
                                            .map { |field, count| t(".missing_field", count:, field: Decidim::SecureElections::CensusMember.field_label(field)) }
                                            .to_sentence) },
                 callout_class: "alert" %>
      <% end %>

      <%= render partial: "members_preview", locals: { election:, members: census_members.first(10) } %>

      <% if census_members.size > 10 %>
        <p class="text-sm text-gray-2 mt-2">
          <%= t(".people_more", count: census_members.size - 10) %>
        </p>
      <% end %>
    <% end %>
  </div>

  <% if allowed_to?(:update, :census, election: election) && census_members.any? %>
    <div class="card-section border-t">
      <%= link_to t(".clear"),
                  election_census_clear_path(election),
                  method: :delete,
                  class: "button button__xs button__transparent-secondary",
                  data: { confirm: t(".clear_confirm", count: census_members.size) } %>
    </div>
  <% end %>
</div>

<% if allowed_to?(:update, :census, election: election) %>
  <div class="card mt-4">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold"><%= t(".add_people_title") %></span>
      </h2>
    </div>

    <div class="card-section">
      <p class="text-sm text-gray-2 mb-4"><%= t(".add_people_help") %></p>

      <%= render partial: "import", locals: { election:, form: import_form } %>
      <%= render partial: "verifications", locals: { election:, form: verifications_form, handlers: available_handlers } %>
    </div>
  </div>
<% end %>

<%# Step 3 of 5. "Continue" only becomes a link once the census is complete —
    the shared footer disables it and names the reason otherwise. %>
<%= render partial: "decidim/secure_elections/admin/shared/step_footer",
           locals: { election:, step: :census } %>
