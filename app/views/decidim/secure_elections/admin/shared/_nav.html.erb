<%#
  The step navigation, above every admin screen of a single election.

  Setting up an election is a sequence — details, ballot, census, schedule,
  publication — and a strict one: a step only opens once every step before it
  is complete. This is the first of the three places that enforce it, and the
  only one an admin ever sees. It is *not* access control on its own: the
  controller redirects (`Admin::WizardStep`) and the permission class withholds
  its grant as well.

  A locked step is never a bare greyed link. It keeps its place, shows a lock
  instead of its number, and says what is missing — in a tooltip, again in text
  only a screen reader announces (a tooltip is `aria-hidden`), and once more in
  plain sight underneath, because a tooltip needs a hover to exist.

  Locals: `election`, and optionally `current` (a step key). `current` is only a
  fallback: the step is normally derived from the controller, so a screen cannot
  claim to be somewhere it is not.
%>
<%
  items = secure_elections_admin_nav_items(election)
  current_key = vocdoni_nav_current_key(local_assigns[:current])
  progress = vocdoni_step_progress(election, current_key)
  # The monitor is never "in the way": it is where the election ends up, not
  # something an admin has to finish.
  blocked = items.reject { |item| item.enabled? || item.key == :monitor }
%>

<%#
  Every screen that shows this navigation gets the admin pack, which is where
  the stepper's own stylesheet lives. Six steps in a `tab-x-container` — a flex
  row that neither wraps nor scrolls — is what made the whole admin page pan
  sideways on a phone, with "Publish" and "Monitor" off screen entirely.

  Both tags are needed. Shakapacker extracts the pack's CSS into a stylesheet of
  its own, and `javascript_pack_tag` does not link it: asking only for the
  JavaScript left `editor.scss` built, fingerprinted, served — and referenced by
  nothing, so every rule in it was dead. That is why the stepper still panned
  sideways after it was given `flex-wrap: wrap`, and it is why the tags belong
  together, in the one partial every screen of an election renders. Both are
  idempotent, so screens that also ask for the pack themselves are unaffected.
%>
<% append_javascript_pack_tag "decidim_secure_elections_admin" %>
<% append_stylesheet_pack_tag "decidim_secure_elections_admin", media: "all" %>

<% if progress.present? %>
  <%# Described from the navigation below, so the position in the sequence is
      announced with the landmark rather than left to be stumbled upon. %>
  <p class="text-sm text-gray-2 mt-2 mb-1" id="js-vocdoni-step-progress">
    <%= progress %>
  </p>
<% end %>

<div class="main-tabs-menu vocdoni-step-nav">
  <div class="main-tabs-menu__tabs">
    <nav class="main-nav"
         aria-label="<%= t("decidim.secure_elections.admin.nav.aria_label") %>"
         <%= tag.attributes(aria: { describedby: ("js-vocdoni-step-progress" if progress.present?) }) %>>
      <ul class="tab-x-container">
        <% items.each do |item| %>
          <li class="<%= "is-active" if item.key == current_key %>">
            <%#
              The marker in front of the label: a tick for what is done, a lock
              for what cannot be opened, the step number otherwise. The number
              is decorative — a screen reader reads the list position — but
              "completed" and "not available yet" are not, so they are text.
            %>
            <% if item.enabled? %>
              <%= link_to item.path, aria: { current: (item.key == current_key ? "page" : nil) } do %>
                <% if item.complete? %>
                  <%= icon "check-line", class: "fill-success", aria_hidden: true %>
                  <span class="sr-only"><%= t("decidim.secure_elections.admin.nav.state.complete") %>:</span>
                <% elsif item.numbered? %>
                  <span aria-hidden="true"><%= item.number %>.</span>
                <% else %>
                  <%= icon item.icon, aria_hidden: true %>
                <% end %>
                <span><%= item.label %></span>
              <% end %>
            <% else %>
              <%= with_tooltip item.reason.to_s, class: "bottom" do %>
                <span class="sidebar-menu__item-disabled" aria-disabled="true">
                  <%= icon "lock-line", aria_hidden: true %>
                  <span><%= item.label %></span>
                  <span class="sr-only">
                    <%= t("decidim.secure_elections.admin.nav.state.locked") %>. <%= item.reason %>
                  </span>
                </span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>

<% if blocked.any? && election.editable? %>
  <p class="text-sm text-gray-2 mt-2 mb-4">
    <%= t("decidim.secure_elections.admin.nav.locked_summary", steps: blocked.map(&:label).to_sentence) %>
    <%= blocked.first.reason %>
  </p>
<% end %>
