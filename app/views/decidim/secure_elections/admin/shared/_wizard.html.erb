<%#
  Compatibility shim.

  The step navigation lives in `decidim/secure_elections/admin/shared/nav`, which derives
  the current step from the controller and therefore needs no `current_step:`.
  This partial only survives so that screens still holding the old call — and
  any local override — keep working.
%>
<%= render partial: "decidim/secure_elections/admin/shared/nav",
           locals: { election:, current: local_assigns[:current_step] } %>
