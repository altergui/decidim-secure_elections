<%#
  The sticky footer of a wizard step: back, save, continue.

  "Continue" is only ever a link when the next step is actually reachable.
  Otherwise it is a disabled button with the reason spelled out underneath —
  an admin who cannot move on should be told what is missing, not handed a
  control that silently does nothing. (The controller redirects and the
  permission class withholds its grant as well; this is only the visible half.)

  Locals:
    `election`   the election
    `step`       the step this footer belongs to
    `form`       optional form builder — renders the submit when the step is
                 editable
    `submit_label` optional override for the submit label
%>
<%
  steps = Decidim::SecureElections::Election::WIZARD_STEPS
  index = steps.index(step)
  previous_step = index&.positive? ? steps[index - 1] : nil
  next_step = index ? steps[index + 1] : nil
  next_blocker = next_step && election.step_blocker(next_step)
  form = local_assigns[:form]
  editable = election.editable?
%>

<div class="item__edit-sticky">
  <div class="item__edit-sticky-container">
    <% if previous_step %>
      <%= link_to secure_elections_step_path(election, previous_step),
                  class: "button button__sm button__transparent-secondary" do %>
        <%= icon "arrow-left-line", aria_hidden: true %>
        <span><%= t("decidim.secure_elections.admin.nav.back_to", step: secure_elections_step_label(previous_step)) %></span>
      <% end %>
    <% end %>

    <% if form.present? && editable %>
      <%#
        One button, not two. Saving a step and moving on is the same act in a
        wizard; the controller keeps the admin here if the step did not become
        complete.
      %>
      <%= form.submit local_assigns.fetch(:submit_label, t("decidim.secure_elections.admin.elections.save_and_continue")),
                      class: "button button__sm button__secondary" %>
    <% elsif next_step && next_blocker.nil? %>
      <%= link_to secure_elections_step_path(election, next_step),
                  class: "button button__sm button__secondary" do %>
        <span><%= t("decidim.secure_elections.admin.nav.continue_to", step: secure_elections_step_label(next_step)) %></span>
      <% end %>
    <% elsif next_step %>
      <button type="button"
              class="button button__sm button__secondary"
              disabled
              aria-disabled="true"
              aria-describedby="js-vocdoni-step-blocked">
        <%= t("decidim.secure_elections.admin.nav.continue_to", step: secure_elections_step_label(next_step)) %>
      </button>
    <% end %>
  </div>

  <% if next_step && next_blocker.present? %>
    <p class="text-sm text-gray-2 mt-2" id="js-vocdoni-step-blocked">
      <%= vocdoni_step_reason(next_blocker) %>
    </p>
  <% end %>
</div>
