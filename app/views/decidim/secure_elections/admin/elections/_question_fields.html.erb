<%#
  One question card of the one-page editor.

  `index` only keeps the parameter names apart; the order that matters is the
  DOM order, which the command turns into `position` when the election is
  saved. When this partial is rendered into the `<template>` the editor clones
  from, `index` is the literal `__QIDX__` and the options are at 0 and 1.

  A real <fieldset> with a <legend>, and every control a real <button>: the
  card can be traversed, understood and reordered from the keyboard alone.
%>
<%
  parent_name = "#{form_name}[questions][#{index}]"
  uid = "q#{index}"
  option_count = question.answers.size
%>

<li class="vocdoni-question card mb-4"
    data-vocdoni-question
    data-uid="<%= uid %>"
    data-next-option-index="<%= option_count %>">
  <%= fields_for parent_name, question do |q| %>
    <fieldset class="card-section">
      <legend class="sr-only" data-vocdoni-question-legend><%= t("decidim.secure_elections.admin.elections.editor.question_legend", number: number) %></legend>

      <%# Tagged so the autosave response can fill in the id of a question that
          did not exist yet, instead of creating it a second time. %>
      <%= q.hidden_field :id, data: { "vocdoni-question-id-field": true } %>
      <%= q.hidden_field :uid, value: uid %>

      <div class="flex items-start justify-between gap-4">
        <p class="text-sm text-gray-2 mb-0" data-vocdoni-question-number><%= t("decidim.secure_elections.admin.elections.editor.question_number", number:, total:) %></p>

        <%#
          The name goes on the *button*, never on the icon inside it.

          `Decidim::LayoutHelper#icon` always sets `aria-hidden="true"` and
          passing `aria_label:` does not remove it, so a label given to the SVG
          is thrown away and the control reaches the accessibility tree as a
          bare "button". These three delete and reorder questions, so they say
          which question they act on — the same way the census table says
          "Remove row 1". `renumber()` keeps the number right after every move.
        %>
        <% unless disabled %>
          <div class="shrink-0 flex items-center gap-1">
            <button type="button"
                    class="button button__xs button__transparent-secondary"
                    aria-label="<%= t("decidim.secure_elections.admin.elections.editor.move_question_up", number:) %>"
                    data-vocdoni-move-question="up">
              <%= icon "arrow-up-line" %>
            </button>
            <button type="button"
                    class="button button__xs button__transparent-secondary"
                    aria-label="<%= t("decidim.secure_elections.admin.elections.editor.move_question_down", number:) %>"
                    data-vocdoni-move-question="down">
              <%= icon "arrow-down-line" %>
            </button>
            <button type="button"
                    class="button button__xs button__transparent-secondary"
                    aria-label="<%= t("decidim.secure_elections.admin.elections.editor.remove_question", number:) %>"
                    data-vocdoni-remove-question>
              <%= icon "close-line" %>
            </button>
          </div>
        <% end %>
      </div>

      <%# Styled from the wrapper rather than with a `class:` on the field: the
          form builder copies that class onto the error message as well, which
          is what rendered "cannot be blank" in display type. %>
      <%# The language switcher core renders next to a translatable field has no
          name of its own. See `ElectionsHelper#secure_elections_language_selector_label`;
          it goes first so it is read before the control it names. %>
      <div class="vocdoni-question__title">
        <%= secure_elections_language_selector_label("vocdoni-question-#{uid}-title-tabs",
                                            t("decidim.secure_elections.admin.elections.editor.question_title_label")) %>
        <%= q.translated :text_field,
                         :title,
                         tabs_id: "vocdoni-question-#{uid}-title-tabs",
                         label: t("decidim.secure_elections.admin.elections.editor.question_title_label"),
                         label_options: { class: "sr-only" },
                         placeholder: t("decidim.secure_elections.admin.elections.editor.question_title_placeholder"),
                         disabled: disabled %>
      </div>

      <div class="vocdoni-question__description">
        <%= secure_elections_language_selector_label("vocdoni-question-#{uid}-description-tabs",
                                            t("decidim.secure_elections.admin.elections.editor.question_description_label")) %>
        <%= q.translated :text_area,
                         :description,
                         tabs_id: "vocdoni-question-#{uid}-description-tabs",
                         label: t("decidim.secure_elections.admin.elections.editor.question_description_label"),
                         label_options: { class: "sr-only" },
                         placeholder: t("decidim.secure_elections.admin.elections.editor.question_description_placeholder"),
                         rows: 2,
                         disabled: disabled %>
      </div>

      <%#
        Only meaningful for a multiple-choice question: upstream ignores
        `typeSetup` for `singlechoice` entirely, and so does the form object.
        Hidden by the editor when the type does not use it, visible (and
        harmlessly dropped on save) when JavaScript is unavailable.
      %>
      <fieldset class="mt-4" data-vocdoni-choice-limits <%= "hidden" unless multichoice %>>
        <legend class="h6"><%= t("decidim.secure_elections.admin.elections.editor.choice_limits_legend") %></legend>
        <p class="help-text"><%= t("decidim.secure_elections.admin.elections.editor.choice_limits_help") %></p>

        <div class="md:flex gap-4">
          <div class="flex-1">
            <%= q.number_field :min_choices, min: 1, disabled: disabled %>
          </div>
          <div class="flex-1">
            <%= q.number_field :max_choices, min: 1, disabled: disabled %>
          </div>
        </div>
      </fieldset>

      <fieldset class="mt-4">
        <legend class="sr-only"><%= t("decidim.secure_elections.admin.elections.editor.options_legend") %></legend>

        <%# "Every question needs two options" belongs on the question, next to
            the options — the offending inputs are flagged individually as well
            (`QuestionForm#enough_options`), so with several questions on the
            page there is nothing left to hunt for. %>
        <%= q.error_for(:answers) %>

        <ul class="list-none m-0" data-vocdoni-options>
          <% question.answers.each_with_index do |option, option_index| %>
            <%= render partial: "decidim/secure_elections/admin/elections/option_fields",
                       locals: {
                         parent_name:,
                         question_index: index,
                         question_number: number,
                         index: option_index,
                         option:,
                         option_number: option_index + 1,
                         multichoice:,
                         disabled:
                       } %>
          <% end %>
        </ul>

        <% unless disabled %>
          <button type="button"
                  class="button button__sm button__transparent-secondary mt-2"
                  data-vocdoni-add-option>
            <%= icon "add-line" %>
            <span><%= t("decidim.secure_elections.admin.elections.editor.add_option") %></span>
          </button>
        <% end %>
      </fieldset>
    </fieldset>
  <% end %>
</li>
