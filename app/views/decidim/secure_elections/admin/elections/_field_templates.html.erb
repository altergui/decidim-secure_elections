<%#
  The blanks the editor clones when the admin adds a question or an option.

  `<template>` content is inert — no Stimulus controller connects, no field is
  submitted — until it is cloned into the page, which is exactly what we want.
  `__QIDX__` and `__AIDX__` are placeholders the editor replaces with fresh
  indices; because they appear in the `name`, the `id` and the `uid` alike, one
  string substitution keeps all three consistent.

  The indices only have to be unique, never contiguous: the on-chain position
  and choice value are derived from DOM order when the election is saved.
%>
<template data-vocdoni-question-template>
  <%= render partial: "decidim/secure_elections/admin/elections/question_fields",
             locals: {
               form_name:,
               index: "__QIDX__",
               number: 0,
               total: 0,
               question: Decidim::SecureElections::Admin::QuestionForm.blank_question,
               multichoice:,
               disabled: false
             } %>
</template>

<template data-vocdoni-option-template>
  <%= render partial: "decidim/secure_elections/admin/elections/option_fields",
             locals: {
               parent_name: "#{form_name}[questions][__QIDX__]",
               question_index: "__QIDX__",
               question_number: 0,
               index: "__AIDX__",
               option: Decidim::SecureElections::Admin::AnswerForm.new,
               option_number: 0,
               multichoice:,
               disabled: false
             } %>
</template>
