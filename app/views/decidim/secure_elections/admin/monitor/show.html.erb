<%#
  Live view of an on-chain election.

  Every number below comes from local columns (`results_cache`, `votes_count`,
  `answers.votes_count`). Rendering this page costs zero requests to Vocdoni;
  only the explicit "refresh" control asks for new numbers, and even that just
  enqueues a job (ARCHITECTURE §0.5).

  The process id and chain id shown here are public identifiers. No credential
  is ever rendered.
%>
<% add_decidim_page_title(t(".title")) %>

<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "decidim/secure_elections/admin/shared/wizard", locals: { election:, current_step: :setup } %>

<% if election.publishing? %>
  <%#
    The process exists upstream but the publication never finished. Publishing
    is idempotent, so the admin is offered a resume rather than left stuck.
  %>
  <%= cell "decidim/announcement",
           { title: t(".incomplete_title"), body: t(".incomplete_body") },
           callout_class: "alert" %>

  <% if allowed_to? :refresh, :monitor, election: election %>
    <p class="mb-6">
      <%= link_to t(".resume"), refresh_election_monitor_path(election), class: "button button__sm button__secondary" %>
    </p>
  <% end %>
<% end %>

<%#
  The live figures are updated in place, not by reloading: an admin who presses
  "Refresh" and still sees the number they had is going to conclude that votes
  are being lost. The pack polls `monitor.json` — the same local read that
  renders this page, no upstream call — until the sync job lands.
%>
<div id="js-vocdoni-monitor"
     class="flex flex-col md:flex-row gap-4 w-full mb-6"
     data-status-url="<%= election_monitor_path(election, format: :json) %>"
     data-refresh-url="<%= refresh_election_monitor_path(election, format: :json) %>"
     data-refreshing-label="<%= t(".refreshing") %>"
     data-refreshed-label="<%= t(".refreshed") %>"
     data-refresh-failed-label="<%= t(".refresh_failed") %>"
     data-refresh-slow-label="<%= t(".refresh_slow") %>">
  <div class="flex-1">
    <div class="card h-full">
      <div class="card-divider">
        <h2 class="card-title"><%= t(".status_title") %></h2>
      </div>
      <div class="card-section">
        <dl>
          <%# The display state, never the raw upstream one: `ready` reads as
              "not started" to anybody who has not read the Vocdoni API docs. %>
          <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.status") %></dt>
          <dd class="mb-4" data-monitor-state><%= secure_elections_election_status_label(election) %></dd>

          <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.start_time") %></dt>
          <dd class="mb-4"><%= vocdoni_start_time_text(election) %></dd>

          <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.end_time") %></dt>
          <dd><%= l(election.end_time, format: :decidim_short) if election.end_time %></dd>
        </dl>

        <%#
          The identifiers and the upstream vocabulary, kept together and kept
          out of the way. They matter when an admin is reading the explorer or
          talking to support, and they are exactly what must not lead.
        %>
        <details class="mt-4">
          <summary class="text-sm text-gray-2 cursor-pointer"><%= t(".technical_title") %></summary>
          <dl class="mt-2">
            <dt class="h6"><%= t(".upstream_status") %></dt>
            <dd class="mb-4"><code class="text-sm" data-monitor-upstream-status><%= vocdoni_upstream_status_label(election) %></code></dd>

            <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.vocdoni_process_id") %></dt>
            <dd class="mb-4"><code class="text-sm break-all"><%= election.vocdoni_process_id %></code></dd>

            <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.vocdoni_chain_id") %></dt>
            <dd><code class="text-sm break-all"><%= election.vocdoni_chain_id.presence || "—" %></code></dd>
          </dl>
        </details>
      </div>
    </div>
  </div>

  <div class="flex-1">
    <div class="card h-full">
      <div class="card-divider">
        <h2 class="card-title justify-between">
          <span class="text-black font-bold"><%= t(".turnout_title") %></span>
          <% if allowed_to? :refresh, :monitor, election: election %>
            <%#
              A link, so the control still works with the pack unavailable: the
              request enqueues the sync job and comes back with a flash. With
              the pack it stays on the page, says it is working, and swaps the
              figures in when the job lands.
            %>
            <%= link_to refresh_election_monitor_path(election),
                        id: "js-vocdoni-monitor-refresh",
                        class: "flex items-center gap-1 text-sm text-secondary",
                        data: { "monitor-refresh": true } do %>
              <%= icon "refresh-line", class: "!w-4 !h-4", aria_hidden: true %>
              <span data-monitor-refresh-label><%= t(".refresh") %></span>
            <% end %>
          <% end %>
        </h2>
      </div>
      <div class="card-section">
        <p class="text-2xl font-bold" data-monitor-turnout><%= vocdoni_turnout_text(election) %></p>

        <p class="text-sm text-gray-2 mt-2" data-monitor-synced><%= secure_elections_last_synced_text(election) %></p>

        <%# Announces the outcome of a refresh — the figures changing silently
            is the failure mode this whole card exists to avoid. %>
        <p class="text-sm text-gray-2 mt-1" role="status" aria-live="polite" data-monitor-feedback></p>

        <p class="text-sm text-gray-2 mt-1"><%= t(".refresh_help") %></p>
      </div>
    </div>
  </div>
</div>

<% if allowed_to? :update_status, :monitor, election: election %>
  <div class="card mb-6">
    <div class="card-divider">
      <h2 class="card-title"><%= t(".controls_title") %></h2>
    </div>
    <div class="card-section">
      <p class="text-sm text-gray-2 mb-4"><%= t(".controls_help") %></p>

      <div class="flex flex-wrap gap-2">
        <% Decidim::SecureElections::Admin::QuestionStatusForm::ALLOWED_STATUSES.each do |status| %>
          <%# `data-confirm` lives on the button: Decidim's confirm dialog binds `form button[data-confirm]`. %>
          <%= button_to status_election_monitor_path(election),
                        method: :put,
                        params: { question_status: { status: } },
                        data: vocdoni_status_confirm_data(status),
                        class: "button button__xs #{status == "canceled" ? "alert" : "button__secondary"}",
                        disabled: election.status == status do %>
            <%= t(status, scope: "decidim.secure_elections.status_actions") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".results_title") %></h2>
  </div>

  <div class="card-section" id="js-vocdoni-monitor-results">
    <% unless election.results_available? %>
      <%= cell "decidim/announcement", t(".no_results_yet"), callout_class: "secondary" %>
    <% end %>

    <% questions.each do |question| %>
      <%= render partial: "decidim/secure_elections/admin/monitor/question_results", locals: { election:, question: } %>
    <% end %>
  </div>
</div>

<%= render partial: "decidim/secure_elections/admin/shared/public_link", locals: { election: } %>
